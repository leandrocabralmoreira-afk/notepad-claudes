+static bool FormatBar_Create() noexcept {
+	if (hwndFormatBar) {
+		return true;
+	}
+	WNDCLASSEX wc = {};
+	wc.cbSize = sizeof(WNDCLASSEX);
+	wc.style = CS_DROPSHADOW;
+	wc.lpfnWndProc = FormatBar_WndProc;
+	wc.hInstance = g_hInstance;
+	wc.hCursor = LoadCursor(nullptr, IDC_ARROW);
+	wc.hbrBackground = GetSysColorBrush(COLOR_BTNFACE);
+	wc.lpszClassName = L"Notepad4FormatBar";
+	RegisterClassEx(&wc);
+
+	const int pad = FormatBar_Pad();
+	const int width = FormatBar_ButtonWidth() * FormatBtn_Count + pad * 2;
+	const int height = FormatBar_ButtonHeight() + pad * 2;
+	hwndFormatBar = CreateWindowEx(WS_EX_TOOLWINDOW | WS_EX_NOACTIVATE, wc.lpszClassName, L"",
+		WS_POPUP | WS_BORDER, 0, 0, width, height, hwndMain, nullptr, g_hInstance, nullptr);
+	if (hwndFormatBar == nullptr) {
+		return false;
+	}
+
+	hwndFormatTip = CreateWindowEx(WS_EX_TOPMOST, TOOLTIPS_CLASS, nullptr, WS_POPUP | TTS_ALWAYSTIP | TTS_NOPREFIX,
+		CW_USEDEFAULT, CW_USEDEFAULT, CW_USEDEFAULT, CW_USEDEFAULT, hwndFormatBar, nullptr, g_hInstance, nullptr);
+	if (hwndFormatTip) {
+		for (int i = 0; i < FormatBtn_Count; i++) {
+			TOOLINFOW ti = {};
+			ti.cbSize = sizeof(TOOLINFOW);
+			ti.uFlags = TTF_SUBCLASS;
+			ti.hwnd = hwndFormatBar;
+			ti.uId = static_cast<UINT_PTR>(i + 1);
+			ti.rect = FormatBar_ButtonRect(i);
+			ti.lpszText = const_cast<LPWSTR>(FormatBar_Tips[i]);
+			SendMessage(hwndFormatTip, TTM_ADDTOOLW, 0, reinterpret_cast<LPARAM>(&ti));
+		}
+	}
+	return true;
+}
+
+static void FormatBar_Show() noexcept {
+	if (!FormatBar_IsActiveLexer() || SciCall_IsSelectionEmpty() || !FormatBar_Create()) {
+		FormatBar_Hide();
+		return;
+	}
+	const Sci_Position start = SciCall_GetSelectionStart();
+	const int lineHeight = SciCall_TextHeight();
+	POINT pt = { SciCall_PointXFromPosition(start), SciCall_PointYFromPosition(start) };
+
+	RECT client;
+	GetClientRect(hwndEdit, &client);
+	if (pt.y < 0 || pt.y > client.bottom) {
+		FormatBar_Hide();
+		return;
+	}
+	ClientToScreen(hwndEdit, &pt);
+
+	const int pad = FormatBar_Pad();
+	const int width = FormatBar_ButtonWidth() * FormatBtn_Count + pad * 2 + 2;
+	const int height = FormatBar_ButtonHeight() + pad * 2 + 2;
+	int x = pt.x;
+	int y = pt.y - height - MulDiv(4, static_cast<int>(FormatBar_Dpi()), 96);
+
+	const HMONITOR hMonitor = MonitorFromPoint(pt, MONITOR_DEFAULTTONEAREST);
+	MONITORINFO mi = { sizeof(MONITORINFO) };
+	GetMonitorInfo(hMonitor, &mi);
+	if (y < mi.rcWork.top) {
+		y = pt.y + lineHeight + MulDiv(4, static_cast<int>(FormatBar_Dpi()), 96);
+	}
+	if (x + width > mi.rcWork.right) {
+		x = mi.rcWork.right - width;
+	}
+	if (x < mi.rcWork.left) {
+		x = mi.rcWork.left;
+	}
+	SetWindowPos(hwndFormatBar, nullptr, x, y, width, height, SWP_NOACTIVATE | SWP_NOZORDER | SWP_SHOWWINDOW);
+}
+
+static void FormatBar_OnTimer() noexcept {
+	KillTimer(hwndMain, ID_FORMATBARTIMER);
+	if (GetKeyState(VK_LBUTTON) < 0 || GetKeyState(VK_SHIFT) < 0) {
+		// ainda arrastando/selecionando: tenta novamente em seguida
+		SetTimer(hwndMain, ID_FORMATBARTIMER, 150, nullptr);
+		return;
+	}
+	if (GetForegroundWindow() != hwndMain) {
+		FormatBar_Hide();
+		return;
+	}
+	FormatBar_Show();
+}
+
+// chamado em SCN_UPDATEUI
+static void FormatBar_OnUpdateUI(unsigned updated) noexcept {
+	if (updated & (SC_UPDATE_TEXT | SC_UPDATE_V_SCROLL)) {
+		FormatBar_UpdateIndicators();
+	}
+	if (updated & (SC_UPDATE_SELECTION | SC_UPDATE_TEXT | SC_UPDATE_V_SCROLL)) {
+		if (SciCall_IsSelectionEmpty() || !FormatBar_IsActiveLexer()) {
+			KillTimer(hwndMain, ID_FORMATBARTIMER);
+			FormatBar_Hide();
+		} else {
+			SetTimer(hwndMain, ID_FORMATBARTIMER, 300, nullptr);
+		}
+	}
+}

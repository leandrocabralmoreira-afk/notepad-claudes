+static void FormatBar_DrawGlyph(HDC hdc, int index, const RECT &rc, bool pressed) noexcept {
+	RECT r = rc;
+	if (pressed) {
+		OffsetRect(&r, 1, 1);
+	}
+	SetBkMode(hdc, TRANSPARENT);
+	SetTextColor(hdc, GetSysColor(COLOR_BTNTEXT));
+	const int cx = (r.left + r.right) / 2;
+	const int cy = (r.top + r.bottom) / 2;
+	const int u = max(1, MulDiv(1, static_cast<int>(FormatBar_Dpi()), 96));
+
+	switch (index) {
+	case FormatBtn_Highlight: {
+		RECT box = { cx - 8 * u, cy - 8 * u, cx + 8 * u, cy + 8 * u };
+		HBRUSH hbr = CreateSolidBrush(RGB(0xFF, 0xFF, 0x00));
+		FillRect(hdc, &box, hbr);
+		DeleteObject(hbr);
+		SelectObject(hdc, hFormatFont[0]);
+		DrawTextW(hdc, L"A", 1, &r, DT_CENTER | DT_VCENTER | DT_SINGLELINE | DT_NOPREFIX);
+	} break;
+	case FormatBtn_Bold:
+		SelectObject(hdc, hFormatFont[1]);
+		DrawTextW(hdc, L"B", 1, &r, DT_CENTER | DT_VCENTER | DT_SINGLELINE | DT_NOPREFIX);
+		break;
+	case FormatBtn_Italic:
+		SelectObject(hdc, hFormatFont[2]);
+		DrawTextW(hdc, L"I", 1, &r, DT_CENTER | DT_VCENTER | DT_SINGLELINE | DT_NOPREFIX);
+		break;
+	case FormatBtn_Underline: {
+		SelectObject(hdc, hFormatFont[0]);
+		DrawTextW(hdc, L"U", 1, &r, DT_CENTER | DT_VCENTER | DT_SINGLELINE | DT_NOPREFIX);
+		RECT line = { cx - 4 * u, cy + 8 * u, cx + 5 * u, cy + 9 * u };
+		FillRect(hdc, &line, GetSysColorBrush(COLOR_BTNTEXT));
+	} break;
+	case FormatBtn_Bullets:
+	case FormatBtn_Numbers:
+		for (int row = 0; row < 3; row++) {
+			const int y = cy + (row - 1) * 6 * u;
+			if (index == FormatBtn_Bullets) {
+				RECT dot = { cx - 9 * u, y - u, cx - 6 * u, y + 2 * u };
+				FillRect(hdc, &dot, GetSysColorBrush(COLOR_BTNTEXT));
+			} else {
+				WCHAR digit = static_cast<WCHAR>(L'1' + row);
+				SelectObject(hdc, hFormatFont[3]);
+				RECT dr = { cx - 11 * u, y - 5 * u, cx - 4 * u, y + 5 * u };
+				DrawTextW(hdc, &digit, 1, &dr, DT_CENTER | DT_VCENTER | DT_SINGLELINE | DT_NOPREFIX);
+			}
+			RECT line = { cx - 3 * u, y, cx + 9 * u, y + u };
+			FillRect(hdc, &line, GetSysColorBrush(COLOR_BTNTEXT));
+		}
+		break;
+	case FormatBtn_Strike: {
+		SelectObject(hdc, hFormatFont[0]);
+		DrawTextW(hdc, L"S", 1, &r, DT_CENTER | DT_VCENTER | DT_SINGLELINE | DT_NOPREFIX);
+		RECT line = { cx - 6 * u, cy, cx + 7 * u, cy + u };
+		FillRect(hdc, &line, GetSysColorBrush(COLOR_BTNTEXT));
+	} break;
+	default:
+		SelectObject(hdc, hFormatFont[0]);
+		DrawTextW(hdc, L"T", 1, &r, DT_CENTER | DT_VCENTER | DT_SINGLELINE | DT_NOPREFIX);
+		SelectObject(hdc, hFormatFont[3]);
+		{
+			RECT xr = { cx + 2 * u, cy - u, cx + 12 * u, cy + 10 * u };
+			SetTextColor(hdc, RGB(0xC0, 0x00, 0x00));
+			DrawTextW(hdc, L"x", 1, &xr, DT_LEFT | DT_TOP | DT_SINGLELINE | DT_NOPREFIX);
+		}
+		break;
+	}
+}

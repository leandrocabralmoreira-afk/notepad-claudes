+static void FormatBar_EnsureFonts() noexcept {
+	const UINT dpi = FormatBar_Dpi();
+	if (hFormatFont[0] != nullptr && uFormatFontDpi == dpi) {
+		return;
+	}
+	for (HFONT &font : hFormatFont) {
+		if (font) {
+			DeleteObject(font);
+			font = nullptr;
+		}
+	}
+	uFormatFontDpi = dpi;
+	const int height = -MulDiv(13, static_cast<int>(dpi), 96);
+	const int small = -MulDiv(8, static_cast<int>(dpi), 96);
+	hFormatFont[0] = CreateFontW(height, 0, 0, 0, FW_NORMAL, FALSE, FALSE, FALSE, DEFAULT_CHARSET, OUT_DEFAULT_PRECIS, CLIP_DEFAULT_PRECIS, DEFAULT_QUALITY, DEFAULT_PITCH | FF_SWISS, L"Segoe UI");
+	hFormatFont[1] = CreateFontW(height, 0, 0, 0, FW_BOLD, FALSE, FALSE, FALSE, DEFAULT_CHARSET, OUT_DEFAULT_PRECIS, CLIP_DEFAULT_PRECIS, DEFAULT_QUALITY, DEFAULT_PITCH | FF_SWISS, L"Segoe UI");
+	hFormatFont[2] = CreateFontW(height, 0, 0, 0, FW_NORMAL, TRUE, FALSE, FALSE, DEFAULT_CHARSET, OUT_DEFAULT_PRECIS, CLIP_DEFAULT_PRECIS, DEFAULT_QUALITY, DEFAULT_PITCH | FF_SWISS, L"Segoe UI");
+	hFormatFont[3] = CreateFontW(small, 0, 0, 0, FW_NORMAL, FALSE, FALSE, FALSE, DEFAULT_CHARSET, OUT_DEFAULT_PRECIS, CLIP_DEFAULT_PRECIS, DEFAULT_QUALITY, DEFAULT_PITCH | FF_SWISS, L"Segoe UI");
+}

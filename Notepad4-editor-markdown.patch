+// FormatBar.h
+// Barra flutuante de formatacao (estilo editor de notas Markdown) para o Notepad4.
+// Incluido diretamente por Notepad4.cpp (nao precisa alterar o projeto).
+//
+// Recursos:
+//  - Ao selecionar texto aparece uma barra com: Realce, Negrito, Italico, Sublinhado,
+//    Marcadores, Lista numerada, Tachado e Limpar formatacao.
+//  - Clicar uma segunda vez no mesmo botao remove a formatacao (toggle).
+//  - Realce (<mark>) e Sublinhado (<u>) sao exibidos ao vivo por indicadores do Scintilla;
+//    negrito/italico/tachado ja sao exibidos pelo lexer de Markdown.
+//  - Ctrl+V com uma imagem na area de transferencia insere ![imagem](data:image/png;base64,...)
+#pragma once
+
+#define ID_FORMATBARTIMER	0xA003
+
+#define IndicatorNumber_FormatUnderline		(INDICATOR_CONTAINER + 3)
+#define IndicatorNumber_FormatHighlight		(INDICATOR_CONTAINER + 4)
+
+enum {
+	FormatBtn_Highlight,
+	FormatBtn_Bold,
+	FormatBtn_Italic,
+	FormatBtn_Underline,
+	FormatBtn_Bullets,
+	FormatBtn_Numbers,
+	FormatBtn_Strike,
+	FormatBtn_Clear,
+	FormatBtn_Count
+};
+
+enum {
+	FormatKind_Bold,
+	FormatKind_Italic,
+	FormatKind_Strike,
+	FormatKind_Underline,
+	FormatKind_Highlight
+};
+
+static HWND hwndFormatBar = nullptr;
+static HWND hwndFormatTip = nullptr;
+static HFONT hFormatFont[4] = {}; // normal, bold, italic, small
+static UINT uFormatFontDpi = 0;
+static int iFormatPressed = -1;
+
+static inline bool FormatBar_IsActiveLexer() noexcept {
+	return pLexCurrent->rid == NP2LEX_MARKDOWN || pLexCurrent->rid == NP2LEX_TEXTFILE;
+}
+
+static inline UINT FormatBar_Dpi() noexcept {
+	return g_uCurrentDPI ? g_uCurrentDPI : 96;
+}
+
+//=============================================================================
+// Marcadores
+//=============================================================================
+static void FormatBar_GetMarks(int kind, const char *&open, const char *&close) noexcept {
+	switch (kind) {
+	case FormatKind_Bold:
+		open = close = "**";
+		break;
+	case FormatKind_Italic:
+		open = close = "*";
+		break;
+	case FormatKind_Strike:
+		open = close = "~~";
+		break;
+	case FormatKind_Underline:
+		open = "<u>";
+		close = "</u>";
+		break;
+	default:
+		open = "<mark>";
+		close = "</mark>";
+		break;
+	}
+}
+
+static bool FormatBar_Match(Sci_Position pos, const char *s) noexcept {
+	const Sci_Position len = static_cast<Sci_Position>(strlen(s));
+	if (pos < 0 || pos + len > SciCall_GetLength()) {
+		return false;
+	}
+	for (Sci_Position i = 0; i < len; i++) {
+		if (static_cast<char>(SciCall_GetCharAt(pos + i)) != s[i]) {
+			return false;
+		}
+	}
+	return true;
+}
+
+static int FormatBar_StarsBefore(Sci_Position pos, int limit) noexcept {
+	int n = 0;
+	while (n < limit && pos - n - 1 >= 0 && SciCall_GetCharAt(pos - n - 1) == '*') {
+		n++;
+	}
+	return n;
+}
+
+static int FormatBar_StarsAfter(Sci_Position pos, int limit) noexcept {
+	int n = 0;
+	const Sci_Position length = SciCall_GetLength();
+	while (n < limit && pos + n < length && SciCall_GetCharAt(pos + n) == '*') {
+		n++;
+	}
+	return n;
+}
+
+static inline void FormatBar_Delete(Sci_Position start, Sci_Position end) noexcept {
+	SciCall_SetTargetRange(start, end);
+	SciCall_ReplaceTarget(0, "");
+}
+
+// 0 = sem formatacao, 1 = marcadores fora do trecho, 2 = marcadores dentro do trecho
+static int FormatBar_SegmentState(int kind, Sci_Position s, Sci_Position e) noexcept {
+	const char *open;
+	const char *close;
+	FormatBar_GetMarks(kind, open, close);
+	const Sci_Position lo = static_cast<Sci_Position>(strlen(open));
+	const Sci_Position lc = static_cast<Sci_Position>(strlen(close));
+
+	if (kind == FormatKind_Bold || kind == FormatKind_Italic) {
+		const int need = (kind == FormatKind_Bold) ? 2 : 1;
+		// fora
+		int m = min(FormatBar_StarsBefore(s, 3), FormatBar_StarsAfter(e, 3));
+		if ((kind == FormatKind_Bold) ? (m >= 2) : (m == 1 || m == 3)) {
+			return 1;
+		}
+		// dentro
+		const Sci_Position len = e - s;
+		int ln = 0;
+		int tn = 0;
+		while (ln < 3 && ln < len && SciCall_GetCharAt(s + ln) == '*') {
+			ln++;
+		}
+		while (tn < 3 && tn < len && SciCall_GetCharAt(e - tn - 1) == '*') {
+			tn++;
+		}
+		m = min(min(ln, tn), static_cast<int>((len - 1) / 2));
+		if ((kind == FormatKind_Bold) ? (m >= 2) : (m == 1 || m == 3)) {
+			return 2;
+		}
+		(void)need;
+		return 0;
+	}
+
+	if (FormatBar_Match(s - lo, open) && FormatBar_Match(e, close)) {
+		return 1;
+	}
+	if (e - s >= lo + lc && FormatBar_Match(s, open) && FormatBar_Match(e - lc, close)) {
+		return 2;
+	}
+	return 0;
+}
+
+// aplica/remove marcadores em um trecho; devolve variacao de tamanho
+static Sci_Position FormatBar_SegmentApply(int kind, Sci_Position s, Sci_Position e, bool remove,
+	Sci_Position &startShift, Sci_Position &endShift) noexcept {
+	const char *open;
+	const char *close;
+	FormatBar_GetMarks(kind, open, close);
+	const Sci_Position lo = static_cast<Sci_Position>(strlen(open));
+	const Sci_Position lc = static_cast<Sci_Position>(strlen(close));
+	startShift = 0;
+	endShift = 0;
+	if (remove) {
+		const int state = FormatBar_SegmentState(kind, s, e);
+		if (state == 1) {
+			FormatBar_Delete(e, e + lc);
+			FormatBar_Delete(s - lo, s);
+			startShift = -lo;
+			endShift = -lo;
+			return -(lo + lc);
+		}
+		if (state == 2) {
+			FormatBar_Delete(e - lc, e);
+			FormatBar_Delete(s, s + lo);
+			startShift = 0;
+			endShift = -(lo + lc);
+			return -(lo + lc);
+		}
+		return 0;
+	}
+	SciCall_InsertText(e, close);
+	SciCall_InsertText(s, open);
+	startShift = lo;
+	endShift = lo;
+	return lo + lc;
+}
+
+struct FormatBarSegment {
+	Sci_Position start;
+	Sci_Position end;
+};
+
+static void FormatBar_GetLineRange(Sci_Position selStart, Sci_Position selEnd, Sci_Line &l0, Sci_Line &l1) noexcept {
+	l0 = SciCall_LineFromPosition(selStart);
+	l1 = SciCall_LineFromPosition(selEnd);
+	if (l1 > l0 && selEnd == SciCall_PositionFromLine(l1)) {
+		l1--;
+	}
+}
+
+static inline bool FormatBar_IsBlank(int ch) noexcept {
+	return ch == ' ' || ch == '\t';
+}
+
+static void FormatBar_ToggleInline(int kind) noexcept {
+	if (SciCall_GetReadOnly() || SciCall_IsSelectionEmpty()) {
+		return;
+	}
+	const Sci_Position selStart = SciCall_GetSelectionStart();
+	const Sci_Position selEnd = SciCall_GetSelectionEnd();
+	Sci_Line l0;
+	Sci_Line l1;
+	FormatBar_GetLineRange(selStart, selEnd, l0, l1);
+	const Sci_Line lineCount = l1 - l0 + 1;
+	FormatBarSegment *segs = static_cast<FormatBarSegment *>(NP2HeapAlloc(static_cast<SIZE_T>(lineCount) * sizeof(FormatBarSegment)));
+	if (segs == nullptr) {
+		return;
+	}
+
+	Sci_Line count = 0;
+	bool allFormatted = true;
+	for (Sci_Line line = l0; line <= l1; line++) {
+		Sci_Position s = max<Sci_Position>(selStart, SciCall_PositionFromLine(line));
+		Sci_Position e = min<Sci_Position>(selEnd, SciCall_GetLineEndPosition(line));
+		while (s < e && FormatBar_IsBlank(SciCall_GetCharAt(s))) {
+			s++;
+		}
+		while (e > s && FormatBar_IsBlank(SciCall_GetCharAt(e - 1))) {
+			e--;
+		}
+		if (s >= e) {
+			continue;
+		}
+		segs[count].start = s;
+		segs[count].end = e;
+		count++;
+		if (FormatBar_SegmentState(kind, s, e) == 0) {
+			allFormatted = false;
+		}
+	}
+
+	if (count == 0) {
+		NP2HeapFree(segs);
+		return;
+	}
+
+	SciCall_BeginUndoAction();
+	Sci_Position firstStartShift = 0;
+	Sci_Position lastEndShift = 0;
+	Sci_Position deltaBeforeLast = 0;
+	for (Sci_Line i = count - 1; i >= 0; i--) {
+		Sci_Position startShift = 0;
+		Sci_Position endShift = 0;
+		Sci_Position delta = 0;
+		if (allFormatted) {
+			delta = FormatBar_SegmentApply(kind, segs[i].start, segs[i].end, true, startShift, endShift);
+		} else if (FormatBar_SegmentState(kind, segs[i].start, segs[i].end) == 0) {
+			delta = FormatBar_SegmentApply(kind, segs[i].start, segs[i].end, false, startShift, endShift);
+		}
+		if (i == 0) {
+			firstStartShift = startShift;
+		}
+		if (i == count - 1) {
+			lastEndShift = endShift;
+		} else {
+			deltaBeforeLast += delta;
+		}
+	}
+	SciCall_EndUndoAction();
+	SciCall_SetSel(segs[0].start + firstStartShift, segs[count - 1].end + deltaBeforeLast + lastEndShift);
+	NP2HeapFree(segs);
+}
+
+//=============================================================================
+// Listas (marcadores / numerada)
+//=============================================================================
+// tipo: 0 = nenhum, 1 = marcador, 2 = numerado
+static int FormatBar_ParseMarker(const char *p, const char *end, int &indentLen, int &markerLen) noexcept {
+	const char *q = p;
+	while (q < end && (*q == ' ' || *q == '\t')) {
+		q++;
+	}
+	indentLen = static_cast<int>(q - p);
+	markerLen = 0;
+	if (q + 1 < end && (*q == '-' || *q == '*' || *q == '+') && (q[1] == ' ' || q[1] == '\t')) {
+		markerLen = 2;
+		return 1;
+	}
+	const char *d = q;
+	while (d < end && *d >= '0' && *d <= '9') {
+		d++;
+	}
+	if (d != q && d - q <= 9 && d + 1 < end && (*d == '.' || *d == ')') && (d[1] == ' ' || d[1] == '\t')) {
+		markerLen = static_cast<int>(d - q) + 2;
+		return 2;
+	}
+	return 0;
+}
+
+static void FormatBar_ToggleList(bool numbered) noexcept {
+	if (SciCall_GetReadOnly()) {
+		return;
+	}
+	const Sci_Position selStart = SciCall_GetSelectionStart();
+	const Sci_Position selEnd = SciCall_GetSelectionEnd();
+	Sci_Line l0;
+	Sci_Line l1;
+	FormatBar_GetLineRange(selStart, selEnd, l0, l1);
+	const Sci_Position rangeStart = SciCall_PositionFromLine(l0);
+	const Sci_Position rangeEnd = SciCall_GetLineEndPosition(l1);
+	const Sci_Position length = rangeEnd - rangeStart;
+	const Sci_Line lineCount = l1 - l0 + 1;
+	if (length <= 0) {
+		// linha vazia: apenas insere o marcador
+		SciCall_BeginUndoAction();
+		SciCall_InsertText(rangeStart, numbered ? "1. " : "- ");
+		SciCall_EndUndoAction();
+		const Sci_Position pos = rangeStart + (numbered ? 3 : 2);
+		SciCall_SetSel(pos, pos);
+		return;
+	}
+
+	char *src = static_cast<char *>(NP2HeapAlloc(static_cast<SIZE_T>(length) + 1));
+	char *dst = static_cast<char *>(NP2HeapAlloc(static_cast<SIZE_T>(length) + static_cast<SIZE_T>(lineCount) * 16 + 16));
+	if (src == nullptr || dst == nullptr) {
+		if (src) {
+			NP2HeapFree(src);
+		}
+		if (dst) {
+			NP2HeapFree(dst);
+		}
+		return;
+	}
+	const Sci_TextRangeFull tr = { { rangeStart, rangeEnd }, src };
+	SciCall_GetTextRangeFull(&tr);
+
+	const int wanted = numbered ? 2 : 1;
+	// 1a passada: todas as linhas nao vazias ja tem o marcador pedido?
+	bool allHave = true;
+	{
+		const char *p = src;
+		const char *const stop = src + length;
+		while (p <= stop) {
+			const char *eol = p;
+			while (eol < stop && *eol != '\r' && *eol != '\n') {
+				eol++;
+			}
+			int indent = 0;
+			int mlen = 0;
+			const int type = FormatBar_ParseMarker(p, eol, indent, mlen);
+			bool blank = true;
+			for (const char *c = p; c < eol; c++) {
+				if (*c != ' ' && *c != '\t') {
+					blank = false;
+					break;
+				}
+			}
+			if (!blank && type != wanted) {
+				allHave = false;
+				break;
+			}
+			if (eol >= stop) {
+				break;
+			}
+			p = eol + ((eol[0] == '\r' && eol + 1 < stop && eol[1] == '\n') ? 2 : 1);
+		}
+	}
+
+	// 2a passada: gera o texto
+	char *out = dst;
+	int counter = 1;
+	{
+		const char *p = src;
+		const char *const stop = src + length;
+		while (p <= stop) {
+			const char *eol = p;
+			while (eol < stop && *eol != '\r' && *eol != '\n') {
+				eol++;
+			}
+			int indent = 0;
+			int mlen = 0;
+			const int type = FormatBar_ParseMarker(p, eol, indent, mlen);
+			bool blank = true;
+			for (const char *c = p; c < eol; c++) {
+				if (*c != ' ' && *c != '\t') {
+					blank = false;
+					break;
+				}
+			}
+			if (blank) {
+				memcpy(out, p, static_cast<size_t>(eol - p));
+				out += eol - p;
+			} else {
+				memcpy(out, p, static_cast<size_t>(indent));
+				out += indent;
+				const char *rest = p + indent + mlen; // se type == 0, mlen == 0
+				if (!allHave) {
+					if (numbered) {
+						out += wsprintfA(out, "%d. ", counter++);
+					} else {
+						*out++ = '-';
+						*out++ = ' ';
+					}
+				}
+				if (type == 0) {
+					rest = p + indent;
+				}
+				memcpy(out, rest, static_cast<size_t>(eol - rest));
+				out += eol - rest;
+			}
+			if (eol >= stop) {
+				break;
+			}
+			const int eolLen = (eol[0] == '\r' && eol + 1 < stop && eol[1] == '\n') ? 2 : 1;
+			memcpy(out, eol, static_cast<size_t>(eolLen));
+			out += eolLen;
+			p = eol + eolLen;
+		}
+	}
+
+	const Sci_Position newLen = out - dst;
+	SciCall_BeginUndoAction();
+	SciCall_SetTargetRange(rangeStart, rangeEnd);
+	SciCall_ReplaceTarget(newLen, dst);
+	SciCall_EndUndoAction();
+	SciCall_SetSel(rangeStart, rangeStart + newLen);
+	NP2HeapFree(src);
+	NP2HeapFree(dst);
+}
+
+//=============================================================================
+// Limpar formatacao
+//=============================================================================
+static bool FormatBar_StartsWith(const char *p, const char *end, const char *token, size_t len) noexcept {
+	return static_cast<size_t>(end - p) >= len && memcmp(p, token, len) == 0;
+}
+
+static void FormatBar_ClearFormatting() noexcept {
+	if (SciCall_GetReadOnly() || SciCall_IsSelectionEmpty()) {
+		return;
+	}
+	Sci_Position selStart = SciCall_GetSelectionStart();
+	Sci_Position selEnd = SciCall_GetSelectionEnd();
+
+	// inclui marcadores que estao imediatamente ao redor da selecao
+	static const char *const pairs[][2] = {
+		{ "<mark>", "</mark>" },
+		{ "<u>", "</u>" },
+		{ "~~", "~~" },
+		{ "**", "**" },
+		{ "*", "*" },
+	};
+	for (int guard = 0; guard < 12; guard++) {
+		bool extended = false;
+		for (const auto &pair : pairs) {
+			const Sci_Position lo = static_cast<Sci_Position>(strlen(pair[0]));
+			const Sci_Position lc = static_cast<Sci_Position>(strlen(pair[1]));
+			if (FormatBar_Match(selStart - lo, pair[0]) && FormatBar_Match(selEnd, pair[1])) {
+				selStart -= lo;
+				selEnd += lc;
+				extended = true;
+				break;
+			}
+		}
+		if (!extended) {
+			break;
+		}
+	}
+
+	const Sci_Position length = selEnd - selStart;
+	char *src = static_cast<char *>(NP2HeapAlloc(static_cast<SIZE_T>(length) + 1));
+	char *dst = static_cast<char *>(NP2HeapAlloc(static_cast<SIZE_T>(length) + 1));
+	if (src == nullptr || dst == nullptr) {
+		if (src) {
+			NP2HeapFree(src);
+		}
+		if (dst) {
+			NP2HeapFree(dst);
+		}
+		return;
+	}
+	const Sci_TextRangeFull tr = { { selStart, selEnd }, src };
+	SciCall_GetTextRangeFull(&tr);
+
+	char *out = dst;
+	const char *p = src;
+	const char *const stop = src + length;
+	bool lineStart = true;
+	while (p < stop) {
+		if (lineStart) {
+			lineStart = false;
+			// preserva indentacao, remove marcadores de bloco
+			const char *q = p;
+			while (q < stop && (*q == ' ' || *q == '\t')) {
+				q++;
+			}
+			memcpy(out, p, static_cast<size_t>(q - p));
+			out += q - p;
+			p = q;
+			int indent = 0;
+			int mlen = 0;
+			if (FormatBar_ParseMarker(p, stop, indent, mlen) != 0 && indent == 0) {
+				p += mlen;
+			} else if (*p == '#') {
+				const char *h = p;
+				while (h < stop && *h == '#') {
+					h++;
+				}
+				if (h - p <= 6 && h < stop && *h == ' ') {
+					p = h + 1;
+				}
+			} else if (*p == '>') {
+				p++;
+				if (p < stop && *p == ' ') {
+					p++;
+				}
+			}
+			continue;
+		}
+		if (*p == '\r' || *p == '\n') {
+			*out++ = *p++;
+			lineStart = true;
+			continue;
+		}
+		if (*p == '<') {
+			if (FormatBar_StartsWith(p, stop, "<mark>", 6)) {
+				p += 6;
+				continue;
+			}
+			if (FormatBar_StartsWith(p, stop, "</mark>", 7)) {
+				p += 7;
+				continue;
+			}
+			if (FormatBar_StartsWith(p, stop, "<u>", 3)) {
+				p += 3;
+				continue;
+			}
+			if (FormatBar_StartsWith(p, stop, "</u>", 4)) {
+				p += 4;
+				continue;
+			}
+		}
+		if (*p == '*') {
+			p++;
+			continue;
+		}
+		if (*p == '~' && p + 1 < stop && p[1] == '~') {
+			p += 2;
+			continue;
+		}
+		*out++ = *p++;
+	}
+
+	const Sci_Position newLen = out - dst;
+	SciCall_BeginUndoAction();
+	SciCall_SetTargetRange(selStart, selEnd);
+	SciCall_ReplaceTarget(newLen, dst);
+	SciCall_EndUndoAction();
+	SciCall_SetSel(selStart, selStart + newLen);
+	NP2HeapFree(src);
+	NP2HeapFree(dst);
+}
+
+static void FormatBar_Execute(int button) noexcept {
+	switch (button) {
+	case FormatBtn_Highlight:
+		FormatBar_ToggleInline(FormatKind_Highlight);
+		break;
+	case FormatBtn_Bold:
+		FormatBar_ToggleInline(FormatKind_Bold);
+		break;
+	case FormatBtn_Italic:
+		FormatBar_ToggleInline(FormatKind_Italic);
+		break;
+	case FormatBtn_Underline:
+		FormatBar_ToggleInline(FormatKind_Underline);
+		break;
+	case FormatBtn_Bullets:
+		FormatBar_ToggleList(false);
+		break;
+	case FormatBtn_Numbers:
+		FormatBar_ToggleList(true);
+		break;
+	case FormatBtn_Strike:
+		FormatBar_ToggleInline(FormatKind_Strike);
+		break;
+	case FormatBtn_Clear:
+		FormatBar_ClearFormatting();
+		break;
+	default:
+		break;
+	}
+	SetFocus(hwndEdit);
+}
+
+//=============================================================================
+// Indicadores (exibicao de <u> e <mark>)
+//=============================================================================
+static void FormatBar_ApplyIndicator(const char *text, Sci_Position base, int indicator, const char *open, const char *close) noexcept {
+	const size_t lo = strlen(open);
+	const size_t lc = strlen(close);
+	const char *p = text;
+	while (true) {
+		const char *q = strstr(p, open);
+		if (q == nullptr) {
+			break;
+		}
+		const char *content = q + lo;
+		const char *r = strstr(content, close);
+		if (r == nullptr) {
+			break;
+		}
+		if (memchr(content, '\n', static_cast<size_t>(r - content)) == nullptr && r > content) {
+			SciCall_SetIndicatorCurrent(indicator);
+			SciCall_IndicatorFillRange(base + (content - text), r - content);
+		}
+		p = r + lc;
+	}
+}
+
+static void FormatBar_UpdateIndicators() noexcept {
+	static bool initialized = false;
+	if (!initialized) {
+		initialized = true;
+		SciCall_IndicSetStyle(IndicatorNumber_FormatHighlight, INDIC_STRAIGHTBOX);
+		SciCall_IndicSetFore(IndicatorNumber_FormatHighlight, RGB(0xFF, 0xFF, 0x00));
+		SciCall_IndicSetAlpha(IndicatorNumber_FormatHighlight, 255);
+		SciCall(SCI_INDICSETUNDER, IndicatorNumber_FormatHighlight, 1);
+		SciCall_IndicSetStyle(IndicatorNumber_FormatUnderline, INDIC_PLAIN);
+		SciCall_IndicSetFore(IndicatorNumber_FormatUnderline, GetSysColor(COLOR_WINDOWTEXT));
+	}
+
+	const Sci_Line lineCount = SciCall_GetLineCount();
+	const Sci_Line first = SciCall_DocLineFromVisible(SciCall_GetFirstVisibleLine());
+	const Sci_Line onScreen = static_cast<Sci_Line>(SciCall(SCI_LINESONSCREEN, 0, 0));
+	Sci_Line last = first + onScreen + 2;
+	if (last >= lineCount) {
+		last = lineCount - 1;
+	}
+	const Sci_Position startPos = SciCall_PositionFromLine(first);
+	const Sci_Position endPos = SciCall_GetLineEndPosition(last);
+
+	SciCall_SetIndicatorCurrent(IndicatorNumber_FormatHighlight);
+	SciCall_IndicatorClearRange(startPos, endPos - startPos);
+	SciCall_SetIndicatorCurrent(IndicatorNumber_FormatUnderline);
+	SciCall_IndicatorClearRange(startPos, endPos - startPos);
+
+	if (!FormatBar_IsActiveLexer() || endPos <= startPos) {
+		return;
+	}
+	// limita o trabalho em linhas gigantes (por exemplo imagens em Base64)
+	if (endPos - startPos > 2 * 1024 * 1024) {
+		return;
+	}
+	char *buf = static_cast<char *>(NP2HeapAlloc(static_cast<SIZE_T>(endPos - startPos) + 1));
+	if (buf == nullptr) {
+		return;
+	}
+	const Sci_TextRangeFull tr = { { startPos, endPos }, buf };
+	SciCall_GetTextRangeFull(&tr);
+	FormatBar_ApplyIndicator(buf, startPos, IndicatorNumber_FormatHighlight, "<mark>", "</mark>");
+	FormatBar_ApplyIndicator(buf, startPos, IndicatorNumber_FormatUnderline, "<u>", "</u>");
+	NP2HeapFree(buf);
+}

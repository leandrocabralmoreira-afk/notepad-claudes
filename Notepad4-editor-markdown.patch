+struct FormatBarGdiplusStartupInput {
+	UINT32 GdiplusVersion;
+	void *DebugEventCallback;
+	BOOL SuppressBackgroundThread;
+	BOOL SuppressExternalCodecs;
+};
+
+// converte um DIB da area de transferencia em PNG usando GDI+ (carregado dinamicamente)
+static bool FormatBar_DibToPng(const BITMAPINFO *bmi, const void *bits, BYTE *&png, size_t &pngLen) noexcept {
+	typedef int (WINAPI *GdiplusStartupFn)(ULONG_PTR *, const FormatBarGdiplusStartupInput *, void *);
+	typedef void (WINAPI *GdiplusShutdownFn)(ULONG_PTR);
+	typedef int (WINAPI *GdipCreateBitmapFromGdiDibFn)(const BITMAPINFO *, void *, void **);
+	typedef int (WINAPI *GdipSaveImageToStreamFn)(void *, IStream *, const CLSID *, const void *);
+	typedef int (WINAPI *GdipDisposeImageFn)(void *);
+
+	HMODULE hGdip = LoadLibraryExW(L"gdiplus.dll", nullptr, LOAD_LIBRARY_SEARCH_SYSTEM32);
+	if (hGdip == nullptr) {
+		return false;
+	}
+	const auto pStartup = reinterpret_cast<GdiplusStartupFn>(GetProcAddress(hGdip, "GdiplusStartup"));
+	const auto pShutdown = reinterpret_cast<GdiplusShutdownFn>(GetProcAddress(hGdip, "GdiplusShutdown"));
+	const auto pFromDib = reinterpret_cast<GdipCreateBitmapFromGdiDibFn>(GetProcAddress(hGdip, "GdipCreateBitmapFromGdiDib"));
+	const auto pSave = reinterpret_cast<GdipSaveImageToStreamFn>(GetProcAddress(hGdip, "GdipSaveImageToStream"));
+	const auto pDispose = reinterpret_cast<GdipDisposeImageFn>(GetProcAddress(hGdip, "GdipDisposeImage"));
+	bool result = false;
+	if (pStartup && pShutdown && pFromDib && pSave && pDispose) {
+		ULONG_PTR token = 0;
+		const FormatBarGdiplusStartupInput input = { 1, nullptr, FALSE, FALSE };
+		if (pStartup(&token, &input, nullptr) == 0) {
+			void *bitmap = nullptr;
+			if (pFromDib(bmi, const_cast<void *>(bits), &bitmap) == 0 && bitmap) {
+				IStream *stream = nullptr;
+				if (SUCCEEDED(CreateStreamOnHGlobal(nullptr, TRUE, &stream))) {
+					// {557CF406-1A04-11D3-9A73-0000F81EF32E} = encoder PNG
+					static const CLSID clsidPng = { 0x557CF406, 0x1A04, 0x11D3, { 0x9A, 0x73, 0x00, 0x00, 0xF8, 0x1E, 0xF3, 0x2E } };
+					if (pSave(bitmap, stream, &clsidPng, nullptr) == 0) {
+						STATSTG stat = {};
+						if (SUCCEEDED(stream->Stat(&stat, STATFLAG_NONAME)) && stat.cbSize.QuadPart > 0) {
+							pngLen = static_cast<size_t>(stat.cbSize.QuadPart);
+							png = static_cast<BYTE *>(NP2HeapAlloc(pngLen));
+							if (png) {
+								LARGE_INTEGER zero = {};
+								ULONG read = 0;
+								stream->Seek(zero, STREAM_SEEK_SET, nullptr);
+								result = SUCCEEDED(stream->Read(png, static_cast<ULONG>(pngLen), &read)) && read == pngLen;
+								if (!result) {
+									NP2HeapFree(png);
+									png = nullptr;
+								}
+							}
+						}
+					}
+					stream->Release();
+				}
+				pDispose(bitmap);
+			}
+			pShutdown(token);
+		}
+	}
+	FreeLibrary(hGdip);
+	return result;
+}
+
+// Retorna true se a area de transferencia continha uma imagem (e ela foi inserida).
+static bool FormatBar_TryPasteImage() noexcept {
+	if (SciCall_GetReadOnly() || !IsClipboardFormatAvailable(CF_DIB)
+		|| IsClipboardFormatAvailable(CF_UNICODETEXT) || IsClipboardFormatAvailable(CF_TEXT)) {
+		return false;
+	}
+	if (!OpenClipboard(hwndMain)) {
+		return false;
+	}
+	bool handled = false;
+	HGLOBAL hDib = static_cast<HGLOBAL>(GetClipboardData(CF_DIB));
+	if (hDib) {
+		const BITMAPINFO *bmi = static_cast<const BITMAPINFO *>(GlobalLock(hDib));
+		if (bmi) {
+			const BITMAPINFOHEADER &bih = bmi->bmiHeader;
+			size_t offset = bih.biSize;
+			if (bih.biBitCount <= 8) {
+				offset += (bih.biClrUsed ? bih.biClrUsed : (1U << bih.biBitCount)) * sizeof(RGBQUAD);
+			} else if (bih.biCompression == BI_BITFIELDS && bih.biSize == sizeof(BITMAPINFOHEADER)) {
+				offset += 3 * sizeof(DWORD);
+			}
+			BYTE *png = nullptr;
+			size_t pngLen = 0;
+			if (FormatBar_DibToPng(bmi, reinterpret_cast<const BYTE *>(bmi) + offset, png, pngLen)) {
+				size_t b64Len = 0;
+				char *b64 = FormatBar_Base64(png, pngLen, b64Len);
+				if (b64) {
+					static const char head[] = "![imagem](data:image/png;base64,";
+					const size_t total = sizeof(head) - 1 + b64Len + 2;
+					char *text = static_cast<char *>(NP2HeapAlloc(total));
+					if (text) {
+						memcpy(text, head, sizeof(head) - 1);
+						memcpy(text + sizeof(head) - 1, b64, b64Len);
+						text[sizeof(head) - 1 + b64Len] = ')';
+						SciCall_ReplaceSel(text);
+						NP2HeapFree(text);
+						handled = true;
+					}
+					NP2HeapFree(b64);
+				}
+				NP2HeapFree(png);
+			}
+			GlobalUnlock(hDib);
+		}
+	}
+	CloseClipboard();
+	return handled;
+}


+static LRESULT CALLBACK FormatBar_WndProc(HWND hwnd, UINT umsg, WPARAM wParam, LPARAM lParam) noexcept {
+	switch (umsg) {
+	case WM_MOUSEACTIVATE:
+		return MA_NOACTIVATE;
+
+	case WM_ERASEBKGND:
+		return 1;
+
+	case WM_PAINT: {
+		PAINTSTRUCT ps;
+		HDC hdc = BeginPaint(hwnd, &ps);
+		RECT rc;
+		GetClientRect(hwnd, &rc);
+		FillRect(hdc, &rc, GetSysColorBrush(COLOR_BTNFACE));
+		FormatBar_EnsureFonts();
+		HGDIOBJ oldFont = SelectObject(hdc, hFormatFont[0]);
+		for (int i = 0; i < FormatBtn_Count; i++) {
+			RECT r = FormatBar_ButtonRect(i);
+			const bool pressed = (i == iFormatPressed);
+			DrawEdge(hdc, &r, pressed ? EDGE_SUNKEN : EDGE_RAISED, BF_RECT);
+			FormatBar_DrawGlyph(hdc, i, r, pressed);
+		}
+		SelectObject(hdc, oldFont);
+		EndPaint(hwnd, &ps);
+	}
+	return 0;
+
+	case WM_LBUTTONDOWN: {
+		const int index = FormatBar_HitTest(static_cast<short>(LOWORD(lParam)), static_cast<short>(HIWORD(lParam)));
+		if (index >= 0) {
+			iFormatPressed = index;
+			SetCapture(hwnd);
+			InvalidateRect(hwnd, nullptr, FALSE);
+		}
+	}
+	return 0;
+
+	case WM_LBUTTONUP: {
+		const int pressed = iFormatPressed;
+		if (pressed >= 0) {
+			iFormatPressed = -1;
+			ReleaseCapture();
+			InvalidateRect(hwnd, nullptr, FALSE);
+			const int index = FormatBar_HitTest(static_cast<short>(LOWORD(lParam)), static_cast<short>(HIWORD(lParam)));
+			if (index == pressed) {
+				FormatBar_Execute(index);
+			}
+		}
+	}
+	return 0;
+
+	default:
+		break;
+	}
+	return DefWindowProc(hwnd, umsg, wParam, lParam);
+}

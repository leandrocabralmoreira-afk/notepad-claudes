+//=============================================================================
+// Colar imagem como Base64 (Markdown)
+//=============================================================================
+static const char Base64Table[] = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+
+static char *FormatBar_Base64(const BYTE *data, size_t length, size_t &outLen) noexcept {
+	const size_t prefixLen = 0;
+	char *out = static_cast<char *>(NP2HeapAlloc(((length + 2) / 3) * 4 + 1 + prefixLen));
+	if (out == nullptr) {
+		return nullptr;
+	}
+	char *p = out;
+	size_t i = 0;
+	for (; i + 2 < length; i += 3) {
+		const unsigned v = (data[i] << 16) | (data[i + 1] << 8) | data[i + 2];
+		*p++ = Base64Table[(v >> 18) & 63];
+		*p++ = Base64Table[(v >> 12) & 63];
+		*p++ = Base64Table[(v >> 6) & 63];
+		*p++ = Base64Table[v & 63];
+	}
+	if (i + 1 == length) {
+		const unsigned v = data[i] << 16;
+		*p++ = Base64Table[(v >> 18) & 63];
+		*p++ = Base64Table[(v >> 12) & 63];
+		*p++ = '=';
+		*p++ = '=';
+	} else if (i + 2 == length) {
+		const unsigned v = (data[i] << 16) | (data[i + 1] << 8);
+		*p++ = Base64Table[(v >> 18) & 63];
+		*p++ = Base64Table[(v >> 12) & 63];
+		*p++ = Base64Table[(v >> 6) & 63];
+		*p++ = '=';
+	}
+	*p = '\0';
+	outLen = static_cast<size_t>(p - out);
+	return out;
+}
